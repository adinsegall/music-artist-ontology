#################################################################
#    Rules
#################################################################

:x rdf:type <http://www.w3.org/2003/11/swrl#Variable> .

:y1 rdf:type <http://www.w3.org/2003/11/swrl#Variable> .

:y2 rdf:type <http://www.w3.org/2003/11/swrl#Variable> .

:c rdf:type <http://www.w3.org/2003/11/swrl#Variable> .

:r1 rdf:type <http://www.w3.org/2003/11/swrl#Variable> .

:r2 rdf:type <http://www.w3.org/2003/11/swrl#Variable> .

:r3 rdf:type <http://www.w3.org/2003/11/swrl#Variable> .

[ <http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled> "true"^^xsd:boolean ;
   rdfs:comment "2+ Collabs" ;
   rdfs:label "CollaborativeArtistRule" ;
   rdf:type <http://www.w3.org/2003/11/swrl#Imp> ;
   <http://www.w3.org/2003/11/swrl#body> [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                           rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#ClassAtom> ;
                                                       <http://www.w3.org/2003/11/swrl#classPredicate> mo:MusicArtist ;
                                                       <http://www.w3.org/2003/11/swrl#argument1> :x
                                                     ] ;
                                           rdf:rest [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                                      rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#IndividualPropertyAtom> ;
                                                                  <http://www.w3.org/2003/11/swrl#propertyPredicate> :collaboratedWith ;
                                                                  <http://www.w3.org/2003/11/swrl#argument1> :x ;
                                                                  <http://www.w3.org/2003/11/swrl#argument2> :y1
                                                                ] ;
                                                      rdf:rest [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                                                 rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#IndividualPropertyAtom> ;
                                                                             <http://www.w3.org/2003/11/swrl#propertyPredicate> :collaboratedWith ;
                                                                             <http://www.w3.org/2003/11/swrl#argument1> :x ;
                                                                             <http://www.w3.org/2003/11/swrl#argument2> :y2
                                                                           ] ;
                                                                 rdf:rest rdf:nil
                                                               ]
                                                    ]
                                         ] ;
   <http://www.w3.org/2003/11/swrl#head> [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                           rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#ClassAtom> ;
                                                       <http://www.w3.org/2003/11/swrl#classPredicate> :CollaborativeArtist ;
                                                       <http://www.w3.org/2003/11/swrl#argument1> :x
                                                     ] ;
                                           rdf:rest rdf:nil
                                         ]
 ] .

[ <http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled> "true"^^xsd:boolean ;
   rdfs:comment "artists with any award" ;
   rdfs:label "AwardWinnerRule" ;
   rdf:type <http://www.w3.org/2003/11/swrl#Imp> ;
   <http://www.w3.org/2003/11/swrl#body> [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                           rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#ClassAtom> ;
                                                       <http://www.w3.org/2003/11/swrl#classPredicate> mo:MusicArtist ;
                                                       <http://www.w3.org/2003/11/swrl#argument1> :x
                                                     ] ;
